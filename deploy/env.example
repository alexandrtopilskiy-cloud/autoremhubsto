# Скопируйте в .env рядом с docker-compose.yml и заполните
# Домен сайта, его A-запись должна указывать на IP сервера. Без своего домена: 1-2-3-4.sslip.io, где 1-2-3-4 — IP сервера через дефисы
DOMAIN=sto.example.ru
# Пароль базы: длинный, только латинские буквы и цифры
POSTGRES_PASSWORD=change-me
# Caddy сам выдаёт HTTPS. Если на сервере уже есть nginx на портах 80/443, удалите эту строку и настройте nginx по DEPLOY.md
COMPOSE_PROFILES=caddy
