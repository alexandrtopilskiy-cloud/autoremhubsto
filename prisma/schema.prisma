// Каждая СТО — отдельная компания (Company). Все рабочие данные несут companyId,
// и доступ к ним идёт только через scoped-клиент из src/lib/tenant.ts.
// Деньги хранятся в копейках (Int), количество и нормочасы — Decimal.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  MECHANIC
}

enum ClientKind {
  PERSON
  ENTREPRENEUR
  LEGAL
}

enum DocStatus {
  DRAFT
  POSTED
}

enum OrderStage {
  NEW
  APPROVING
  IN_WORK
  READY
  CLOSED
}

enum AppointmentStage {
  NEW
  CONFIRMED
  IN_WORK
  DONE
  CANCELLED
}

enum CashboxKind {
  CASH
  BANK
}

enum StockMoveKind {
  RECEIPT
  ORDER
}

enum LineKind {
  WORK
  ITEM
}

enum DocKind {
  ORDER
  ESTIMATE
  RECEIPT
}

enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

enum RecommendationStatus {
  OPEN
  DONE
  DECLINED
}

enum PartsRequestStatus {
  NEW
  ISSUED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  SBP
}

model Company {
  id              String           @id @default(cuid())
  name            String
  city            String?
  hourPrice       Int              @default(0) // стоимость нормочаса по умолчанию, коп.
  utcOffset       Int              @default(180) // часовой пояс СТО, минуты от UTC (Москва = 180)
  dayStart        Int              @default(540) // начало рабочего дня, минуты от полуночи
  dayEnd          Int              @default(1260) // конец рабочего дня
  createdAt       DateTime         @default(now())
  memberships     Membership[]
  organizations   Organization[]
  clients         Client[]
  vehicles        Vehicle[]
  employees       Employee[]
  works           Work[]
  products        Product[]
  workOrders      WorkOrder[]
  payments        Payment[]
  counters        Counter[]
  suppliers       Supplier[]
  receipts        Receipt[]
  stockMoves      StockMove[]
  cashboxes       Cashbox[]
  cashOps         CashOperation[]
  workplaces      Workplace[]
  appointments    Appointment[]
  attachments     Attachment[]
  estimates       Estimate[]
  recommendations Recommendation[]
  partsRequests   PartsRequest[]
}

// Юрлицо или ИП внутри СТО: от его имени оформляются документы.
model Organization {
  id         String      @id @default(cuid())
  companyId  String
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  inn        String?
  kpp        String?
  ogrn       String?
  address    String?
  phone      String?
  createdAt  DateTime    @default(now())
  workOrders WorkOrder[]

  @@index([companyId])
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  passwordHash  String
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  sessions      Session[]
  partsRequests PartsRequest[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      Role
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
}

model Session {
  id        String   @id // sha256 от токена в cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Сквозная нумерация документов внутри компании: ЗН-1, ЗН-2 ...
model Counter {
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key       String
  value     Int     @default(0)

  @@id([companyId, key])
}

model Client {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind            ClientKind       @default(PERSON)
  name            String
  phone           String?
  email           String?
  inn             String?
  comment         String?
  discount        Int              @default(0) // скидка клиента, %
  source          String? // откуда пришёл: рекламный источник
  archived        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  vehicles        Vehicle[]
  workOrders      WorkOrder[]
  appointments    Appointment[]
  estimates       Estimate[]
  recommendations Recommendation[]

  @@index([companyId, name])
  @@index([companyId, phone])
}

model Vehicle {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  make            String
  model           String
  year            Int?
  vin             String?
  plate           String?
  color           String?
  createdAt       DateTime         @default(now())
  workOrders      WorkOrder[]
  appointments    Appointment[]
  estimates       Estimate[]
  recommendations Recommendation[]

  @@index([companyId, plate])
  @@index([companyId, vin])
}

// Исполнитель работ: мастер (не обязательно с логином) или менеджер.
model Employee {
  id            String          @id @default(cuid())
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  position      String?
  workPercent   Int             @default(0) // % от работ для расчёта зарплаты
  salesPercent  Int             @default(0) // % менеджера от суммы проведённых заказ-нарядов
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  orderWorks    WorkOrderWork[]
  managedOrders WorkOrder[]     @relation("OrderManager")
  appointments  Appointment[]

  @@index([companyId])
}

// Справочник работ.
model Work {
  id         String          @id @default(cuid())
  companyId  String
  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  normHours  Decimal?        @db.Decimal(8, 2)
  price      Int             @default(0) // фиксированная цена, коп.; 0 = считать по нормочасам
  createdAt  DateTime        @default(now())
  orderWorks WorkOrderWork[]

  @@index([companyId, name])
}

// Номенклатура (запчасти и материалы).
model Product {
  id           String             @id @default(cuid())
  companyId    String
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  article      String?
  brand        String?
  unit         String             @default("шт")
  price        Int                @default(0) // цена продажи, коп.
  createdAt    DateTime           @default(now())
  orderItems   WorkOrderItem[]
  receiptLines ReceiptLine[]
  stockMoves   StockMove[]
  requestLines PartsRequestLine[]

  @@index([companyId, name])
  @@index([companyId, article])
}

model WorkOrder {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number          Int
  status          DocStatus        @default(DRAFT)
  stage           OrderStage       @default(NEW)
  organizationId  String?
  organization    Organization?    @relation(fields: [organizationId], references: [id])
  clientId        String
  client          Client           @relation(fields: [clientId], references: [id])
  vehicleId       String?
  vehicle         Vehicle?         @relation(fields: [vehicleId], references: [id])
  managerId       String?
  manager         Employee?        @relation("OrderManager", fields: [managerId], references: [id])
  mileage         Int?
  reason          String?
  comment         String?
  acceptedAt      DateTime         @default(now())
  closedAt        DateTime?
  createdAt       DateTime         @default(now())
  works           WorkOrderWork[]
  items           WorkOrderItem[]
  payments        Payment[]
  appointment     Appointment?
  estimate        Estimate?
  recommendations Recommendation[] @relation("RecommendationSource")
  partsRequests   PartsRequest[]

  @@unique([companyId, number])
  @@index([companyId, acceptedAt])
}

model WorkOrderWork {
  id         String    @id @default(cuid())
  orderId    String
  order      WorkOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  workId     String?
  work       Work?     @relation(fields: [workId], references: [id])
  name       String
  normHours  Decimal   @default(1) @db.Decimal(8, 2)
  price      Int // цена за 1 нормочас или за работу целиком, коп.
  discount   Int       @default(0) // %
  executorId String?
  executor   Employee? @relation(fields: [executorId], references: [id])
  position   Int       @default(0)
}

model WorkOrderItem {
  id        String    @id @default(cuid())
  orderId   String
  order     WorkOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?  @relation(fields: [productId], references: [id])
  name      String
  article   String?
  qty       Decimal   @db.Decimal(12, 3)
  price     Int // за единицу, коп.
  discount  Int       @default(0) // %
  position  Int       @default(0)
}

model Payment {
  id        String        @id @default(cuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderId   String
  order     WorkOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Int // коп., возврат — отрицательная сумма
  method    PaymentMethod
  cashboxId String?
  cashbox   Cashbox?      @relation(fields: [cashboxId], references: [id])
  paidAt    DateTime      @default(now())
  comment   String?

  @@index([companyId, paidAt])
}

model Supplier {
  id        String          @id @default(cuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  inn       String?
  phone     String?
  comment   String?
  createdAt DateTime        @default(now())
  receipts  Receipt[]
  cashOps   CashOperation[]

  @@index([companyId, name])
}

// Приходная накладная от поставщика. При проведении товар поступает на склад.
model Receipt {
  id          String        @id @default(cuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number      Int
  status      DocStatus     @default(DRAFT)
  supplierId  String?
  supplier    Supplier?     @relation(fields: [supplierId], references: [id])
  supplierDoc String? // номер накладной поставщика
  date        DateTime      @default(now())
  comment     String?
  createdAt   DateTime      @default(now())
  lines       ReceiptLine[]

  @@unique([companyId, number])
  @@index([companyId, date])
}

model ReceiptLine {
  id        String  @id @default(cuid())
  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade) // удаление товара из накладной запрещено в catalog.deleteProduct
  qty       Decimal @db.Decimal(12, 3)
  cost      Int // закупочная цена за единицу, коп.
  position  Int     @default(0)
}

// Движение товара: приход (+) или расход в заказ-наряд (−). Остаток = сумма qty.
model StockMove {
  id        String        @id @default(cuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty       Decimal       @db.Decimal(12, 3)
  cost      Int           @default(0) // себестоимость единицы, коп.
  kind      StockMoveKind
  docId     String // Receipt.id или WorkOrder.id
  date      DateTime      @default(now())

  @@index([companyId, productId])
  @@index([docId])
}

// Касса (наличные) или расчётный счёт.
model Cashbox {
  id        String          @id @default(cuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  kind      CashboxKind
  createdAt DateTime        @default(now())
  payments  Payment[]
  ops       CashOperation[]

  @@index([companyId])
}

// Приход или расход денег, не связанный с оплатой заказ-наряда: аренда, оплата поставщику, внесение.
model CashOperation {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cashboxId  String
  cashbox    Cashbox   @relation(fields: [cashboxId], references: [id], onDelete: Cascade)
  amount     Int // коп., расход — отрицательная сумма
  category   String
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  comment    String?
  date       DateTime  @default(now())

  @@index([companyId, date])
}

// Пост (рабочее место): подъёмник, развал-схождение и т.п.
model Workplace {
  id           String        @id @default(cuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  active       Boolean       @default(true)
  position     Int           @default(0)
  createdAt    DateTime      @default(now())
  appointments Appointment[]

  @@index([companyId])
}

// Запись клиента на сервис: время на посту, из неё создаётся заказ-наряд.
model Appointment {
  id           String           @id @default(cuid())
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workplaceId  String
  workplace    Workplace        @relation(fields: [workplaceId], references: [id], onDelete: Cascade)
  startAt      DateTime
  endAt        DateTime
  stage        AppointmentStage @default(NEW)
  clientId     String?
  client       Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  vehicleId    String?
  vehicle      Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  contactName  String? // для нового клиента, которого ещё нет в базе
  contactPhone String?
  reason       String?
  amount       Int              @default(0) // ориентировочная сумма, коп.
  masterId     String?
  master       Employee?        @relation(fields: [masterId], references: [id], onDelete: SetNull)
  orderId      String?          @unique
  order        WorkOrder?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())

  @@index([companyId, startAt])
  @@index([workplaceId, startAt])
}

// Файл или фото к документу. Хранится в базе (до 10 МБ), выдаётся через /app/files/[id] с проверкой компании.
model Attachment {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  docKind   DocKind
  docId     String
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([companyId, docKind, docId])
}

// Калькуляция: предварительный расчёт ремонта для клиента, переводится в заказ-наряд.
model Estimate {
  id        String         @id @default(cuid())
  companyId String
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number    Int
  status    EstimateStatus @default(DRAFT)
  clientId  String
  client    Client         @relation(fields: [clientId], references: [id])
  vehicleId String?
  vehicle   Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  comment   String?
  orderId   String?        @unique
  order     WorkOrder?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())
  lines     EstimateLine[]

  @@unique([companyId, number])
  @@index([companyId, createdAt])
}

model EstimateLine {
  id         String   @id @default(cuid())
  estimateId String
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  kind       LineKind
  workId     String?
  productId  String?
  name       String
  article    String?
  qty        Decimal  @db.Decimal(12, 3) // нормочасы для работы, количество для товара
  price      Int
  discount   Int      @default(0)
  position   Int      @default(0)
}

// Рекомендация клиенту: работа или товар, которые предложили, но не сделали.
model Recommendation {
  id          String               @id @default(cuid())
  companyId   String
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vehicleId   String?
  vehicle     Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  orderId     String?
  order       WorkOrder?           @relation("RecommendationSource", fields: [orderId], references: [id], onDelete: SetNull)
  kind        LineKind
  name        String
  qty         Decimal              @default(1) @db.Decimal(12, 3)
  price       Int                  @default(0)
  comment     String?
  status      RecommendationStatus @default(OPEN)
  doneOrderId String? // заказ-наряд, в который рекомендацию перенесли
  createdAt   DateTime             @default(now())

  @@index([companyId, status])
  @@index([clientId])
}

// Требование на запчасти: мастер просит товар со склада под заказ-наряд, кладовщик выдаёт.
model PartsRequest {
  id            String             @id @default(cuid())
  companyId     String
  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number        Int
  orderId       String
  order         WorkOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status        PartsRequestStatus @default(NEW)
  requestedById String?
  requestedBy   User?              @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  comment       String?
  createdAt     DateTime           @default(now())
  issuedAt      DateTime?
  lines         PartsRequestLine[]

  @@unique([companyId, number])
  @@index([companyId, status])
}

model PartsRequestLine {
  id        String       @id @default(cuid())
  requestId String
  request   PartsRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty       Decimal      @db.Decimal(12, 3)
}
