// Каждая СТО — отдельная компания (Company). Все рабочие данные несут companyId,
// и доступ к ним идёт только через scoped-клиент из src/lib/tenant.ts.
// Деньги хранятся в копейках (Int), количество и нормочасы — Decimal.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  MECHANIC
}

enum ClientKind {
  PERSON
  ENTREPRENEUR
  LEGAL
}

enum DocStatus {
  DRAFT
  POSTED
}

enum OrderStage {
  NEW
  APPROVING
  IN_WORK
  READY
  CLOSED
}

enum AppointmentStage {
  NEW
  CONFIRMED
  IN_WORK
  DONE
  CANCELLED
}

enum CashboxKind {
  CASH
  BANK
}

enum StockMoveKind {
  RECEIPT
  ORDER
  SALE
  WRITE_OFF
  INVENTORY
}

// База для процента зарплаты: стоимость без скидки, конечная стоимость (со скидкой) или прибыль (минус себестоимость).
enum PayBase {
  PRICE
  FINAL
  PROFIT
}

enum PayrollEntryKind {
  BONUS
  DEDUCTION
}

enum SupplierOrderStatus {
  NEW
  SENT
  RECEIVED
  CANCELLED
}

enum LineKind {
  WORK
  ITEM
}

enum DocKind {
  ORDER
  ESTIMATE
  RECEIPT
  EMPLOYEE // личные документы сотрудника (скан паспорта и т. п.), доступ только с правом «staff»
}

// Менеджер работает в программе (приёмщик, % менеджера), исполнитель выполняет работы (% исполнителя).
enum EmployeeKind {
  MANAGER
  EXECUTOR
}

enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

enum RecommendationStatus {
  OPEN
  DONE
  DECLINED
}

enum PartsRequestStatus {
  NEW
  ISSUED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  SBP
}

model Company {
  id               String            @id @default(cuid())
  name             String
  city             String?
  hourPrice        Int               @default(0) // стоимость нормочаса по умолчанию, коп.
  utcOffset        Int               @default(180) // часовой пояс СТО, минуты от UTC (Москва = 180)
  dayStart         Int               @default(540) // начало рабочего дня, минуты от полуночи
  dayEnd           Int               @default(1260) // конец рабочего дня
  createdAt        DateTime          @default(now())
  memberships      Membership[]
  organizations    Organization[]
  clients          Client[]
  vehicles         Vehicle[]
  employees        Employee[]
  works            Work[]
  products         Product[]
  workOrders       WorkOrder[]
  payments         Payment[]
  counters         Counter[]
  suppliers        Supplier[]
  receipts         Receipt[]
  stockMoves       StockMove[]
  cashboxes        Cashbox[]
  cashOps          CashOperation[]
  workplaces       Workplace[]
  appointments     Appointment[]
  attachments      Attachment[]
  estimates        Estimate[]
  recommendations  Recommendation[]
  partsRequests    PartsRequest[]
  sales            Sale[]
  writeOffs        WriteOff[]
  inventories      Inventory[]
  supplierOrders   SupplierOrder[]
  payrollEntries   PayrollEntry[]
  roles            CompanyRole[]
  workGroups       WorkGroup[]
  carModifications CarModification[]
  productGroups    ProductGroup[]
  priceCategories  PriceCategory[]
  dictItems        DictionaryItem[]
  trash            TrashItem[]
  customDicts      DictKind[]        @default([]) // справочники, которые СТО уже меняла; остальные — стандартные
}

// Юрлицо или ИП внутри СТО: от его имени оформляются документы.
model Organization {
  id         String      @id @default(cuid())
  companyId  String
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  inn        String?
  kpp        String?
  ogrn       String?
  address    String?
  phone      String?
  createdAt  DateTime    @default(now())
  workOrders WorkOrder[]

  @@index([companyId])
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  passwordHash  String
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  sessions      Session[]
  partsRequests PartsRequest[]
  employees     Employee[]
}

model Membership {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role         Role // для своей роли — базовая роль, права берутся из customRole
  customRoleId String?
  customRole   CompanyRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())

  @@unique([userId, companyId])
}

// Своя роль СТО с правами по разделам (src/lib/permissions.ts).
model CompanyRole {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  permissions Json         @default("{}")
  createdAt   DateTime     @default(now())
  members     Membership[]

  @@unique([companyId, name])
}

model Session {
  id        String   @id // sha256 от токена в cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Сквозная нумерация документов внутри компании: ЗН-1, ЗН-2 ...
model Counter {
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key       String
  value     Int     @default(0)

  @@id([companyId, key])
}

model Client {
  id              String              @id @default(cuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code            String? // ID клиента: из файла при загрузке, иначе присваивается сам (000001…)
  kind            ClientKind          @default(PERSON)
  name            String // наименование для документов
  phone           String?
  email           String?
  inn             String?
  kpp             String?
  ogrn            String?
  legalAddress    String?
  actualAddress   String?
  postalAddress   String?
  comment         String?
  discount        Int                 @default(0) // скидка на работы, %
  partsDiscount   Int                 @default(0) // скидка на товары, %
  hourPrice       Int? // своя стоимость нормочаса, коп.; пусто — по категории или как у СТО
  priceCategoryId String?
  priceCategory   PriceCategory?      @relation(fields: [priceCategoryId], references: [id], onDelete: SetNull)
  source          String? // откуда пришёл: рекламный источник
  archived        Boolean             @default(false)
  createdAt       DateTime            @default(now())
  vehicles        Vehicle[]
  workOrders      WorkOrder[]
  appointments    Appointment[]
  estimates       Estimate[]
  recommendations Recommendation[]
  sales           Sale[]
  contacts        ClientContact[]
  bankAccounts    ClientBankAccount[]

  @@unique([companyId, code])
  @@index([companyId, name])
  @@index([companyId, phone])
}

// Контактное лицо клиента. Телефон первого контакта дублируется в Client.phone для списков и поиска.
model ClientContact {
  id         String  @id @default(cuid())
  clientId   String
  client     Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  code       String? // ID контакта: ID клиента + 2 цифры
  sort       Int     @default(0)
  lastName   String?
  firstName  String?
  middleName String?
  gender     String? // M | F
  phone      String?
  note       String?

  @@index([clientId, sort])
  @@index([phone])
}

model ClientBankAccount {
  id       String  @id @default(cuid())
  clientId String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  code     String?
  sort     Int     @default(0)
  bik      String?
  account  String?
  note     String?

  @@index([clientId, sort])
}

model Vehicle {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  make            String
  model           String
  year            Int?
  vin             String?
  plate           String?
  color           String?
  code            String? // ID автомобиля: ID клиента + 01 + номер + 01, как в АвтоДилере
  frame           String?
  body            String?
  engineType      String?
  engineCode      String?
  power           Int? // л.с.
  engineVolume    String? // л
  transmission    String?
  drive           String?
  note            String?
  createdAt       DateTime         @default(now())
  workOrders      WorkOrder[]
  appointments    Appointment[]
  estimates       Estimate[]
  recommendations Recommendation[]

  @@index([companyId, plate])
  @@index([companyId, vin])
}

// Справочник автомобилей: одна строка — модификация из файла «Справочник ТС» (марка, модель, кузов, двигатель, КПП, привод).
// Загрузка нового файла заменяет справочник целиком; автомобили клиентов хранят значения текстом и от него не зависят.
model CarModification {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  make         String
  model        String
  yearFrom     Int?
  yearTo       Int?
  body         String // номер кузова (поколение), например XV70
  engineCode   String
  engineVolume String // л, «2.5»; «Не применимо» у электромобилей
  power        Int? // л.с.
  transmission String
  drive        String
  engineType   String
  createdAt    DateTime @default(now())

  @@index([companyId, make, model])
}

// Исполнитель работ: мастер (не обязательно с логином) или менеджер.
model Employee {
  id             String          @id @default(cuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind           EmployeeKind    @default(EXECUTOR)
  name           String // ФИО
  position       String?
  phone          String?
  address        String? // адрес проживания
  passportSeries String?
  passportNumber String?
  hiredAt        DateTime?       @db.Date
  firedAt        DateTime?       @db.Date // заполнена — уволен, в новые документы не выбирается
  userId         String? // логин в программу (для менеджеров), связывается в «Пользователи и доступ»
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  workPercent    Int             @default(0) // % исполнителя от его работ
  workBase       PayBase         @default(FINAL) // PRICE или FINAL
  salesPercent   Int             @default(0) // % менеджера от работ его заказ-нарядов (и от товаров, если itemsPercent пуст)
  itemsPercent   Int? // % менеджера от товаров
  itemsBase      PayBase         @default(FINAL) // FINAL или PROFIT
  paidOnly       Boolean         @default(false) // считать только полностью оплаченные заказ-наряды
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  orderWorks     WorkOrderWork[]
  managedWorks   WorkOrderWork[] @relation("WorkManager")
  managedItems   WorkOrderItem[] @relation("ItemManager")
  managedOrders  WorkOrder[]     @relation("OrderManager")
  appointments   Appointment[]
  payrollEntries PayrollEntry[]
  payouts        CashOperation[]

  @@index([companyId])
}

// Справочник работ.
model Work {
  id              String          @id @default(cuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  normHours       Decimal?        @db.Decimal(8, 2)
  price           Int             @default(0) // фиксированная цена, коп.; 0 = считать по нормочасам
  executorPercent Int? // свой % исполнителю за эту работу вместо % сотрудника
  groupId         String? // обязательна у новых работ; пусто только у работ, заведённых до групп
  group           WorkGroup?      @relation(fields: [groupId], references: [id])
  createdAt       DateTime        @default(now())
  orderWorks      WorkOrderWork[]

  @@index([companyId, name])
  @@index([groupId])
}

// Группа работ (Подвеска, Двигатель…); порядок — как добавляли.
model WorkGroup {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  works     Work[]

  @@unique([companyId, name])
}

// Номенклатура (запчасти и материалы).
model Product {
  id                 String              @id @default(cuid())
  companyId          String
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name               String
  article            String?
  brand              String?
  unit               String              @default("шт")
  price              Int                 @default(0) // цена продажи, коп.
  groupId            String?
  group              ProductGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  barcode            String?
  minQty             Decimal?            @db.Decimal(12, 3) // минимальный остаток, ниже — дефицит
  categoryPrices     ProductPrice[]
  createdAt          DateTime            @default(now())
  orderItems         WorkOrderItem[]
  receiptLines       ReceiptLine[]
  stockMoves         StockMove[]
  requestLines       PartsRequestLine[]
  saleLines          SaleLine[]
  writeOffLines      WriteOffLine[]
  inventoryLines     InventoryLine[]
  supplierOrderLines SupplierOrderLine[]

  @@unique([companyId, barcode])
  @@index([companyId, name])
  @@index([companyId, article])
  @@index([companyId, groupId])
}

/// 9.5 Группа товаров в справочнике.
model ProductGroup {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  products  Product[]

  @@unique([companyId, name])
}

model WorkOrder {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number          Int
  numberPrefix    String           @default("") // буква перед цифрами у документа с повторившимся номером: ЗН-A519
  externalId      String? // ID документа в АвтоДилере, по нему повторная загрузка обновляет, а не дублирует
  status          DocStatus        @default(DRAFT)
  stage           OrderStage       @default(NEW)
  organizationId  String?
  organization    Organization?    @relation(fields: [organizationId], references: [id])
  clientId        String
  client          Client           @relation(fields: [clientId], references: [id])
  vehicleId       String?
  vehicle         Vehicle?         @relation(fields: [vehicleId], references: [id])
  managerId       String?
  manager         Employee?        @relation("OrderManager", fields: [managerId], references: [id])
  mileage         Int?
  reason          String?
  comment         String?
  acceptedAt      DateTime         @default(now())
  closedAt        DateTime?
  createdAt       DateTime         @default(now())
  works           WorkOrderWork[]
  items           WorkOrderItem[]
  payments        Payment[]
  appointment     Appointment?
  estimate        Estimate?
  recommendations Recommendation[] @relation("RecommendationSource")
  partsRequests   PartsRequest[]
  inspection      Inspection?

  @@unique([companyId, numberPrefix, number])
  @@unique([companyId, externalId])
  @@index([companyId, acceptedAt])
}

model WorkOrderWork {
  id              String    @id @default(cuid())
  orderId         String
  order           WorkOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  workId          String?
  work            Work?     @relation(fields: [workId], references: [id])
  name            String
  normHours       Decimal   @default(1) @db.Decimal(8, 2)
  price           Int // цена за 1 нормочас или за работу целиком, коп.
  discount        Int       @default(0) // %
  discountSum     Int? // скидка суммой, коп.; если задана — вместо процента (документы из АвтоДилера с дробным % и коэффициентом)
  executorId      String?
  executor        Employee? @relation(fields: [executorId], references: [id])
  executorPercent Int? // % исполнителю, как в АвтоДилере
  executorAmount  Int? // начислено исполнителю, коп.
  managerId       String?
  manager         Employee? @relation("WorkManager", fields: [managerId], references: [id])
  managerAmount   Int? // начислено менеджеру, коп.
  position        Int       @default(0)
}

model WorkOrderItem {
  id            String    @id @default(cuid())
  orderId       String
  order         WorkOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?  @relation(fields: [productId], references: [id])
  name          String
  article       String?
  qty           Decimal   @db.Decimal(12, 3)
  price         Int // за единицу, коп.
  discount      Int       @default(0) // %
  discountSum   Int? // скидка суммой, коп.; если задана — вместо процента
  brand         String? // производитель
  cost          Int? // закупочная цена за единицу, коп.
  managerId     String?
  manager       Employee? @relation("ItemManager", fields: [managerId], references: [id])
  managerAmount Int? // начислено менеджеру, коп.
  position      Int       @default(0)
}

model Payment {
  id        String        @id @default(cuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderId   String
  order     WorkOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Int // коп., возврат — отрицательная сумма
  method    PaymentMethod
  cashboxId String?
  cashbox   Cashbox?      @relation(fields: [cashboxId], references: [id])
  paidAt    DateTime      @default(now())
  comment   String?

  @@index([companyId, paidAt])
}

model Supplier {
  id        String          @id @default(cuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  inn       String?
  phone     String?
  comment   String?
  createdAt DateTime        @default(now())
  receipts  Receipt[]
  cashOps   CashOperation[]
  orders    SupplierOrder[]

  @@index([companyId, name])
}

// Приходная накладная от поставщика. При проведении товар поступает на склад.
model Receipt {
  id              String          @id @default(cuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number          Int
  numberPrefix    String          @default("")
  externalId      String?
  status          DocStatus       @default(DRAFT)
  supplierId      String?
  supplier        Supplier?       @relation(fields: [supplierId], references: [id])
  supplierDoc     String? // номер накладной поставщика
  supplierOrderId String?         @unique
  supplierOrder   SupplierOrder?  @relation(fields: [supplierOrderId], references: [id], onDelete: SetNull)
  date            DateTime        @default(now())
  comment         String?
  createdAt       DateTime        @default(now())
  lines           ReceiptLine[]
  payments        CashOperation[]

  @@unique([companyId, numberPrefix, number])
  @@unique([companyId, externalId])
  @@index([companyId, date])
}

model ReceiptLine {
  id        String  @id @default(cuid())
  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade) // удаление товара из накладной запрещено в catalog.deleteProduct
  qty       Decimal @db.Decimal(12, 3)
  cost      Int // закупочная цена за единицу, коп.
  sum       Int? // сумма строки из документа АвтоДилера, коп.; там цена за единицу точнее копейки
  position  Int     @default(0)
}

// Движение товара: приход (+) или расход в заказ-наряд (−). Остаток = сумма qty.
model StockMove {
  id        String        @id @default(cuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty       Decimal       @db.Decimal(12, 3)
  cost      Int           @default(0) // себестоимость единицы, коп.
  kind      StockMoveKind
  docId     String // id документа: приход, заказ-наряд, реализация, списание, инвентаризация
  date      DateTime      @default(now())

  @@index([companyId, productId])
  @@index([docId])
}

// Касса (наличные) или расчётный счёт.
model Cashbox {
  id        String          @id @default(cuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  kind      CashboxKind
  createdAt DateTime        @default(now())
  payments  Payment[]
  ops       CashOperation[]

  @@index([companyId])
}

// Приход или расход денег, не связанный с оплатой заказ-наряда: аренда, оплата поставщику, внесение.
model CashOperation {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cashboxId  String
  cashbox    Cashbox   @relation(fields: [cashboxId], references: [id], onDelete: Cascade)
  amount     Int // коп., расход — отрицательная сумма
  category   String
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  employeeId String? // выплата зарплаты
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  saleId     String? // оплата реализации
  sale       Sale?     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  receiptId  String? // оплата приходной накладной поставщику
  receipt    Receipt?  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  comment    String?
  date       DateTime  @default(now())

  @@index([companyId, date])
}

// Пост (рабочее место): подъёмник, развал-схождение и т.п.
model Workplace {
  id           String        @id @default(cuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  active       Boolean       @default(true)
  position     Int           @default(0)
  createdAt    DateTime      @default(now())
  appointments Appointment[]

  @@index([companyId])
}

// Запись клиента на сервис: время на посту, из неё создаётся заказ-наряд.
model Appointment {
  id           String           @id @default(cuid())
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workplaceId  String
  workplace    Workplace        @relation(fields: [workplaceId], references: [id], onDelete: Cascade)
  startAt      DateTime
  endAt        DateTime
  stage        AppointmentStage @default(NEW)
  clientId     String?
  client       Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  vehicleId    String?
  vehicle      Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  contactName  String? // для нового клиента, которого ещё нет в базе
  contactPhone String?
  reason       String?
  amount       Int              @default(0) // ориентировочная сумма, коп.
  masterId     String?
  master       Employee?        @relation(fields: [masterId], references: [id], onDelete: SetNull)
  orderId      String?          @unique
  order        WorkOrder?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())

  @@index([companyId, startAt])
  @@index([workplaceId, startAt])
}

// Файл или фото к документу. Хранится в базе (до 10 МБ), выдаётся через /app/files/[id] с проверкой компании.
model Attachment {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  docKind   DocKind
  docId     String
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([companyId, docKind, docId])
}

// Калькуляция: предварительный расчёт ремонта для клиента, переводится в заказ-наряд.
model Estimate {
  id        String         @id @default(cuid())
  companyId String
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number    Int
  status    EstimateStatus @default(DRAFT)
  clientId  String
  client    Client         @relation(fields: [clientId], references: [id])
  vehicleId String?
  vehicle   Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  comment   String?
  orderId   String?        @unique
  order     WorkOrder?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())
  lines     EstimateLine[]

  @@unique([companyId, number])
  @@index([companyId, createdAt])
}

model EstimateLine {
  id         String   @id @default(cuid())
  estimateId String
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  kind       LineKind
  workId     String?
  productId  String?
  name       String
  article    String?
  qty        Decimal  @db.Decimal(12, 3) // нормочасы для работы, количество для товара
  price      Int
  discount   Int      @default(0)
  position   Int      @default(0)
}

// Рекомендация клиенту: работа или товар, которые предложили, но не сделали.
model Recommendation {
  id          String               @id @default(cuid())
  companyId   String
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vehicleId   String?
  vehicle     Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  orderId     String?
  order       WorkOrder?           @relation("RecommendationSource", fields: [orderId], references: [id], onDelete: SetNull)
  kind        LineKind
  name        String
  qty         Decimal              @default(1) @db.Decimal(12, 3)
  price       Int                  @default(0)
  comment     String?
  status      RecommendationStatus @default(OPEN)
  doneOrderId String? // заказ-наряд, в который рекомендацию перенесли
  createdAt   DateTime             @default(now())

  @@index([companyId, status])
  @@index([clientId])
}

// Требование на запчасти: мастер просит товар со склада под заказ-наряд, кладовщик выдаёт.
model PartsRequest {
  id            String             @id @default(cuid())
  companyId     String
  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number        Int
  orderId       String
  order         WorkOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status        PartsRequestStatus @default(NEW)
  requestedById String?
  requestedBy   User?              @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  comment       String?
  createdAt     DateTime           @default(now())
  issuedAt      DateTime?
  lines         PartsRequestLine[]

  @@unique([companyId, number])
  @@index([companyId, status])
}

model PartsRequestLine {
  id        String       @id @default(cuid())
  requestId String
  request   PartsRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty       Decimal      @db.Decimal(12, 3)
}

// Акт осмотра автомобиля при приёмке: повреждения кузова, топливо, комплектность, отметки.
model Inspection {
  id        String    @id @default(cuid())
  orderId   String    @unique
  order     WorkOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fuel      Int? // уровень топлива, % (0, 25, 50, 75, 100)
  items     String[] // что есть в машине из списка комплектности
  damages   Json      @default("[]") // [{ zone, type, note }]
  dirty     Boolean   @default(false) // принят грязным
  dark      Boolean   @default(false) // принят в тёмное время
  notes     String?
  updatedAt DateTime  @updatedAt
}

// Реализация: продажа товара без ремонта. При проведении товар списывается со склада.
model Sale {
  id           String          @id @default(cuid())
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number       Int
  numberPrefix String          @default("")
  externalId   String?
  status       DocStatus       @default(DRAFT)
  clientId     String? // пусто — розничный покупатель
  client       Client?         @relation(fields: [clientId], references: [id])
  date         DateTime        @default(now()) // при проведении — дата проведения
  comment      String?
  createdAt    DateTime        @default(now())
  lines        SaleLine[]
  payments     CashOperation[]

  @@unique([companyId, numberPrefix, number])
  @@unique([companyId, externalId])
  @@index([companyId, date])
}

model SaleLine {
  id          String  @id @default(cuid())
  saleId      String
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty         Decimal @db.Decimal(12, 3)
  price       Int // коп.
  discount    Int     @default(0)
  discountSum Int? // скидка суммой, коп.; если задана — вместо процента
  cost        Int? // закупочная цена за единицу, коп.
  position    Int     @default(0)
}

// Списание товара: брак, порча, расход на нужды СТО.
model WriteOff {
  id        String         @id @default(cuid())
  companyId String
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number    Int
  status    DocStatus      @default(DRAFT)
  reason    String?
  date      DateTime       @default(now())
  createdAt DateTime       @default(now())
  lines     WriteOffLine[]

  @@unique([companyId, number])
  @@index([companyId, date])
}

model WriteOffLine {
  id         String   @id @default(cuid())
  writeOffId String
  writeOff   WriteOff @relation(fields: [writeOffId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty        Decimal  @db.Decimal(12, 3)
  position   Int      @default(0)
}

// Инвентаризация: фактический остаток против учётного. При проведении разница становится движением склада.
model Inventory {
  id        String          @id @default(cuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number    Int
  status    DocStatus       @default(DRAFT)
  comment   String?
  date      DateTime        @default(now())
  createdAt DateTime        @default(now())
  lines     InventoryLine[]

  @@unique([companyId, number])
  @@index([companyId, date])
}

model InventoryLine {
  id          String    @id @default(cuid())
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  bookQty     Decimal   @db.Decimal(12, 3) // учётный остаток; при проведении пересчитывается
  actualQty   Decimal   @db.Decimal(12, 3)

  @@unique([inventoryId, productId])
}

// Заказ поставщику. Не двигает склад; по нему создаётся приходная накладная.
model SupplierOrder {
  id         String              @id @default(cuid())
  companyId  String
  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number     Int
  status     SupplierOrderStatus @default(NEW)
  supplierId String
  supplier   Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  comment    String?
  createdAt  DateTime            @default(now())
  lines      SupplierOrderLine[]
  receipt    Receipt?

  @@unique([companyId, number])
  @@index([companyId, createdAt])
}

model SupplierOrderLine {
  id        String        @id @default(cuid())
  orderId   String
  order     SupplierOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty       Decimal       @db.Decimal(12, 3)
  cost      Int // ожидаемая закупочная цена, коп.
  position  Int           @default(0)
}

// Премия или удержание сотруднику, вручную, к расчёту зарплаты за месяц даты.
model PayrollEntry {
  id         String           @id @default(cuid())
  companyId  String
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind       PayrollEntryKind
  amount     Int // коп., всегда положительная
  date       DateTime         @default(now())
  comment    String?
  createdAt  DateTime         @default(now())

  @@index([companyId, date])
}

/// 9.7 Категория цен: клиенту с категорией товары продаются по своим ценам, работы — по своей цене нормочаса.
model PriceCategory {
  id        String         @id @default(cuid())
  companyId String
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  percent   Int            @default(0) // наценка (+) или скидка (−) к базовой цене товара, %
  hourPrice Int? // цена нормочаса для категории, коп.; пусто — как у СТО
  clients   Client[]
  prices    ProductPrice[]

  @@unique([companyId, name])
}

/// Своя цена товара в категории; без неё цена считается от базовой по проценту категории.
model ProductPrice {
  productId  String
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   PriceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  price      Int // коп.

  @@id([productId, categoryId])
}

/// 9.10 Общие справочники: списки для подсказок и выбора в формах.
enum DictKind {
  UNIT
  BRAND
  COLOR
  REPAIR_KIND
  DAMAGE_TYPE
  KIT_ITEM
  CLIENT_SOURCE
  WRITE_OFF_REASON
}

/// Строка общего справочника СТО. Пока СТО справочник не меняла, используется стандартный список из кода.
model DictionaryItem {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind      DictKind
  name      String
  position  Int

  @@unique([companyId, kind, name])
  @@index([companyId, kind, position])
}

/// 12.6 Корзина: удалённый документ хранится снимком вместе со строками и восстанавливается из него.
model TrashItem {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind          String // вид документа, см. src/lib/services/trash.ts
  docId         String
  title         String
  data          Json
  deletedAt     DateTime @default(now())
  deletedById   String?
  deletedByName String?

  @@index([companyId, deletedAt])
}
